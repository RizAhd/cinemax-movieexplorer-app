# Copy this file to a new file called .env and put your own TMDb API key after the =
# Get a free key at https://www.themoviedb.org/settings/api (use the "API Key (v3 auth)")
# Then stop and start `npm start` again, because the .env file is only read at startup.
# Never commit your real .env file.
REACT_APP_TMDB_KEY=your_tmdb_api_key_here
